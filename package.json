{
  "name": "platform-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "check:architecture": "node --experimental-strip-types --no-warnings scripts/architecture/check.ts",
    "test:architecture": "node --experimental-strip-types --no-warnings --test scripts/architecture/check.test.ts",
    "typecheck:scripts": "tsc -p tsconfig.json",
    "check": "pnpm run check:architecture && pnpm run test:architecture && pnpm run typecheck:scripts && pnpm run typecheck && pnpm run test",
    "start": "pnpm --filter @platform-hub/hub-api start"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^22.15.0",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3"
  }
}

# WO-E8 — custody-service environment (no database)

CUSTODY_BIND=0.0.0.0:8787

# Vault (required)
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=
VAULT_MOUNT=expadio

# Shared with platform-web (min 16 chars)
CUSTODY_TICKET_SECRET=

# Fingerprint key for intake
CUSTODY_FINGERPRINT_KEY=

# Browser BYOK cross-origin (comma-separated)
# CUSTODY_CORS_ORIGINS=https://platform.example.com,https://platform.staging.example.com

# Never enable in production
# CUSTODY_ALLOW_DEV_TICKETS=true

# FORBIDDEN — do not set:
# DATABASE_URL=
